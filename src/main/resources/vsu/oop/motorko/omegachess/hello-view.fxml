<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vsu.oop.motorko.omegachess.HelloController"
      style="-fx-background-color: #312e2b;"> <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
</padding>

    <Label text="Omega Chess" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"/>

    <GridPane fx:id="boardGrid" alignment="CENTER" hgap="1.0" vgap="1.0">
    </GridPane>

    <Label fx:id="statusLabel" text="Ход белых" style="-fx-text-fill: #cccccc;"/>

</VBox>